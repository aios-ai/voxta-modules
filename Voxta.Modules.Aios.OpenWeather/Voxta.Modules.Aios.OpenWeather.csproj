<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Shared/Tools/Tools.projitems" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Dependencies next to the DLL, so Voxta can load the build folder as a dev folder. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="OpenWeather.Tools.Tests" />
        <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
        <PackageReference Include="GeoTimeZone" Version="6.1.0" />
        <!-- Read IMAGE_DEPENDENCIES.md before updating these intentionally pinned versions. -->
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
        <!-- The oldest Voxta version supported by module.json. Voxta provides these assemblies at runtime. -->
        <PackageReference Include="Voxta.Sdk.Modules" Version="1.13.0-alpha.10" ExcludeAssets="runtime" />
    </ItemGroup>
    
    <ItemGroup>
      <None Update="Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <EmbeddedResource Include="Licenses\*.txt" />
      <None Remove="Data\countries.csv" />
      <EmbeddedResource Include="Data\countries.csv" />
      <None Remove="Data\bounding-boxes.json" />
      <EmbeddedResource Include="Data\bounding-boxes.json" />
      <None Remove="Assets\OpenWeather.png" />
      <EmbeddedResource Include="Assets\OpenWeather.png" />
    </ItemGroup>
    
</Project>
