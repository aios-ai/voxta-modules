<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Dependencies next to the DLL, so Voxta can load the build folder as a dev folder. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
        <!-- The oldest Voxta version supported by module.json. Voxta provides these assemblies at runtime. -->
        <PackageReference Include="Voxta.Sdk.Modules" Version="1.13.0-alpha.4" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\spotify.png" />
    </ItemGroup>

</Project>
