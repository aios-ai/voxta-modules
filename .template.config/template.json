{
  "$schema": "http://json.schemastore.org/template",
  "author": "Voxta",
  "classifications": ["Voxta", "Module"],
  "identity": "Voxta.Modules.Template",
  "name": "Voxta module",
  "shortName": "voxta-module",
  "sourceName": "MyModule",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        ".git/**",
        ".vs/**",
        ".idea/**",
        "dist/**"
      ]
    }
  ],
  "symbols": {
    "label": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "spacedWords",
      "replaces": "My Module"
    },
    "augmentationKey": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "snakeCase",
      "replaces": "my_module"
    }
  },
  "forms": {
    "spacedWords": {
      "identifier": "replace",
      "pattern": "(?<=[a-z0-9])(?=[A-Z])",
      "replacement": " "
    },
    "underscored": {
      "identifier": "replace",
      "pattern": "(?<=[a-z0-9])(?=[A-Z])|[^A-Za-z0-9]+",
      "replacement": "_"
    },
    "lowerCase": {
      "identifier": "lowerCase"
    },
    "snakeCase": {
      "identifier": "chain",
      "steps": ["underscored", "lowerCase"]
    }
  }
}
