<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- The beta starts with the platform we can exercise locally and keeps the release below Voxta's 32 MB limit. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(VoxtaModulePack)' != ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BergamotTranslatorSharp" Version="0.7.0" />
    <PackageReference Include="Voxta.Sdk.Modules" Version="1.13.0-beta.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.svg" />
  </ItemGroup>
</Project>
